# ===========================================
# RIVETO Admin Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# API Server URL
# ===========================================
# For local development:
VITE_SERVER_URL=http://localhost:3000

# For production (Render deployment):
# VITE_SERVER_URL=https://riveto-backend.onrender.com

# ===========================================
# Backend URL (Alternative)
# ===========================================
# Alternative variable name for backend URL
# VITE_BACKEND_URL=https://your-backend-url.com